# Hämta nycklar från https://api.tradera.com/register
TRADERA_APP_ID=
TRADERA_APP_KEY=
TRADERA_CATEGORY_ID=181806
TRADERA_QUERY=
TRADERA_ORDER_BY=EndDateDescending
POLL_INTERVAL_SECONDS=300
MAX_PAGES=3
# Kompletterande sökning med motsatt sluttidssortering (0 = avstängd)
SECONDARY_SEARCH_EVERY=3
SECONDARY_SEARCH_PAGES=1
DATA_DIR=./data
PORT=3001

# Pushover (valfritt, aktiveras när båda anges)
# Skapa app på https://pushover.net/apps/build
PUSHOVER_APP_TOKEN=
# Your User Key på https://pushover.net/
PUSHOVER_USER_KEY=

# Discord (valfritt: kan användas samtidigt som Pushover)
# Hämta webhook-URL från Discord-kanalens integrationer; behandla den som ett lösenord.
DISCORD_WEBHOOK_URL=

# Kontroll av annonsstatus (GET /v4/items/{itemId}); 0 = ingen detaljkontroll
STATUS_CHECKS_PER_SCAN=3
STATUS_RECHECK_HOURS=24
# Rensning körs högst en gång per dygn. Verifierat avslutade annonser behålls i 90 dagar.
LISTING_RETENTION_DAYS=90
# Saknas en annons från sökresultaten under 180 dagar kan en obekräftad post gallras.
# En annons som API nyligen bekräftat aktiv skyddas alltid från denna gallring.
STALE_LISTING_DAYS=180
SEARCH_HISTORY_DAYS=30
SCAN_HISTORY_DAYS=30
NOTIFICATION_HISTORY_DAYS=30
