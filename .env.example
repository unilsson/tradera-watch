# Hämta nycklar från https://api.tradera.com/register
TRADERA_APP_ID=
TRADERA_APP_KEY=
TRADERA_CATEGORY_ID=181806
TRADERA_QUERY=
TRADERA_ORDER_BY=EndDateDescending
POLL_INTERVAL_SECONDS=300
MAX_PAGES=3
# Kompletterande sökning med motsatt sluttidssortering (0 = avstängd)
SECONDARY_SEARCH_EVERY=3
SECONDARY_SEARCH_PAGES=1
DATA_DIR=./data
PORT=3001

# Pushover (valfritt, aktiveras när båda anges)
# Skapa app på https://pushover.net/apps/build
PUSHOVER_APP_TOKEN=
# Your User Key på https://pushover.net/
PUSHOVER_USER_KEY=
